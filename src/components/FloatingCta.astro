---
import { withBase } from '../lib/paths';
---

<a href={withBase('/request-a-quote')} class="floating-cta">Request a Quote</a>

<style>
	.floating-cta {
		position: fixed;
		right: 1.5rem;
		bottom: 1.5rem;
		z-index: 45;
		background: var(--color-primary);
		color: #fff;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
		padding: 0.85rem 1.35rem;
		border-radius: 100px;
		box-shadow: var(--shadow-md);
	}

	.floating-cta:hover {
		background: var(--color-primary-hover);
	}

	@media (max-width: 860px) {
		.floating-cta {
			right: 1rem;
			bottom: 1rem;
			padding: 0.75rem 1.1rem;
			font-size: 0.85rem;
		}
	}
</style>
