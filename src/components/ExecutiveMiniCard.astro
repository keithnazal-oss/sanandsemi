---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import AvatarPlaceholder from './AvatarPlaceholder.astro';

interface Props {
	name: string;
	position: string;
	photo?: ImageMetadata;
	href: string;
}

const { name, position, photo, href } = Astro.props;
---

<a class="exec-card" href={href} aria-label={`${name}, ${position} — view full leadership profile`}>
	<div class="exec-photo">
		{photo ? <Image src={photo} alt={`Photo of ${name}`} width={120} height={120} /> : <AvatarPlaceholder />}
	</div>
	<div class="exec-text">
		<p class="exec-name">{name}</p>
		<p class="exec-position">{position}</p>
	</div>
</a>

<style>
	.exec-card {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 14px;
		background: var(--color-bg);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		color: inherit;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.exec-card:hover,
	.exec-card:focus-visible {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: var(--color-primary);
	}

	.exec-photo {
		flex: none;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		overflow: hidden;
	}

	.exec-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.exec-text {
		min-width: 0;
	}

	.exec-name {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--color-ink);
		line-height: 1.25;
	}

	.exec-position {
		margin: 0.2rem 0 0;
		font-size: 0.72rem;
		color: var(--color-text-muted);
		line-height: 1.3;
	}

	@media (prefers-reduced-motion: reduce) {
		.exec-card {
			transition: none;
		}
	}
</style>
